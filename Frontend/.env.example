# Public browser/build values: never put passwords, secret keys or tokens here.
# Leave blank locally for Vite's /api proxy and on Vercel for same-origin /api.
VITE_API_BASE_URL=
# Use the same official Supabase project as the backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Development-only proxy target; this is not included in the browser bundle.
API_PROXY_TARGET=http://localhost:3001

