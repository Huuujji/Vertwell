# Leave blank locally to use Vite's /api proxy.
# Production example: https://your-backend.vercel.app (without /api).
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Development-only proxy target; this is not included in the browser bundle.
API_PROXY_TARGET=http://localhost:3001

