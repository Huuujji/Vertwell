{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    { "source": "/api(/.*)?", "destination": "/api/index" },
    { "source": "/:path((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
