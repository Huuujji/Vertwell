# Copy to ignored backend/.env.operations.local. No real values in this example.
VERTWELL_OPS_BASE_URL=http://127.0.0.1:3001
# Current Owner session access token, entered privately; expires normally.
VERTWELL_OPS_ACCESS_TOKEN=
# Hosted checks require this exact approved HTTPS origin and --allow-hosted.
# Do not run hosted checks before the final deployment phase and its scope.
VERTWELL_OPS_EXPECTED_ORIGIN=
