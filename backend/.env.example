PORT=3001
# Comma-separated exact frontend origins. Add the production Vercel URL when deploying.
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never put this in VITE_* or commit a real value.
SUPABASE_SECRET_KEY=
# Optional locally: shared tests the database-backed limiter after migration.
# Production and Vercel require shared; memory is development-only.
LOGIN_RATE_LIMIT_MODE=
# Operational warning threshold in milliseconds (100–60000); not a shop SLA.
SLOW_REQUEST_MS=2000

