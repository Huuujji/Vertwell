PORT=3001
# Comma-separated exact origins (scheme + host + optional port; no path/trailing slash).
# Replace this local value with the approved application origin for hosted use.
# Add only individually approved preview origins; no wildcard.
CORS_ORIGINS=http://localhost:5173
# Same official project as VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never put this in VITE_* or commit a real value.
SUPABASE_SECRET_KEY=
# Optional locally: shared tests the database-backed limiter after migration.
# Production and Vercel require shared; memory is development-only.
LOGIN_RATE_LIMIT_MODE=
# Operational warning threshold in milliseconds (100–60000); not a shop SLA.
SLOW_REQUEST_MS=2000

# Brevo application email. Leave blank until the later user-operated sender and
# public-origin gates are satisfied. All four are required; no default sender or
# Reply-To is assumed. These are server-only values, never VITE_* variables.
# Canonical approved HTTPS application origin, without a path/query/fragment.
ACCOUNT_EMAIL_ORIGIN=
# Brevo API key, not an SMTP key. Keep the actual value private and uncommitted.
BREVO_API_KEY=
# Separately approved sender and actual reply address. Neither is selected here.
ACCOUNT_EMAIL_FROM=
ACCOUNT_EMAIL_REPLY_TO=

