{
  "name": "@vertwell/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/app.test.ts tests/database.test.ts tests/permissions.test.ts tests/inventory.test.ts tests/checkout.test.ts",
    "test:database": "node --import tsx --test tests/database.test.ts",
    "integration:schema": "tsx scripts/integration-schema.ts",
    "db:inspect": "tsx scripts/database.ts inspect",
    "db:apply": "tsx scripts/database.ts apply",
    "db:verify": "tsx scripts/database.ts verify",
    "db:smoke": "tsx scripts/verify-development.ts",
    "permissions:verify": "tsx scripts/verify-permissions.ts",
    "inventory:verify": "tsx scripts/verify-inventory.ts",
    "checkout:verify": "tsx scripts/verify-checkout.ts",
    "checkout:activate": "tsx scripts/activate-checkout.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "auth:verify": "tsx scripts/verify-authentication.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
